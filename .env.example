# Shared integration env for KubeAssist-stack (copy to .env locally — do not commit secrets)

# --- Auth (MUST match on both sides) ---
AI_SHARED_TOKEN=dev-shared-token-change-me
AI_AUTH_TOKEN=dev-shared-token-change-me

# --- Python AI ---
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=5

# --- Go (set in the same PowerShell session before `go run`) ---
PORT=8080
ENABLE_LOCAL_MODE=false
# ENABLE_RELAY, KUBECONFIG, and KUBE_CONTEXT are left unset.
# Set ENABLE_LOCAL_MODE=true plus KUBECONFIG and KUBE_CONTEXT to talk to Kind directly.
AI_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgres://kubeassist:kubeassist_dev_password@localhost:5432/kubeassist?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
