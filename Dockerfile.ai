# Build context: ./ai-service (junction OK as context root on Windows).
# Schemas are NOT copied here — compose mounts ./schemas → /schemas at runtime
# (paths.py: SERVICE_DIR=/app → REPO_ROOT=/ → SCHEMAS_DIR=/schemas).
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY data ./data
COPY scripts ./scripts
COPY pytest.ini .

ENV PYTHONPATH=/app
ENV LLM_MOCK=true
ENV AI_SHARED_TOKEN=dev-shared-token-change-me
ENV HOST=0.0.0.0
ENV PORT=8000

RUN python scripts/build_index.py

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
